# Bismi Cabs .htaccess
Options -Indexes
ServerSignature Off

# HTTPS redirect
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# www to non-www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Remove .html extension
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ .html [NC,L]

# 301 redirects for clean URLs
RewriteRule ^best-drop-taxi-service-adyar$ /best-drop-taxi-service-adyar.html [R=301,L]
RewriteRule ^best-drop-taxi-service-anna-nagar$ /best-drop-taxi-service-anna-nagar.html [R=301,L]
RewriteRule ^best-drop-taxi-service-velachery$ /best-drop-taxi-service-velachery.html [R=301,L]
RewriteRule ^best-drop-taxi-service-tambaram$ /best-drop-taxi-service-tambaram.html [R=301,L]
RewriteRule ^best-drop-taxi-service-t-nagar$ /best-drop-taxi-service-t-nagar.html [R=301,L]
RewriteRule ^best-drop-taxi-service-omr$ /best-drop-taxi-service-omr.html [R=301,L]
RewriteRule ^best-drop-taxi-service-ecr$ /best-drop-taxi-service-ecr.html [R=301,L]
RewriteRule ^best-drop-taxi-service-ambattur$ /best-drop-taxi-service-ambattur.html [R=301,L]
RewriteRule ^best-drop-taxi-service-avadi$ /best-drop-taxi-service-avadi.html [R=301,L]
RewriteRule ^best-drop-taxi-service-perungudi$ /best-drop-taxi-service-perungudi.html [R=301,L]
RewriteRule ^best-drop-taxi-service-sholinganallur$ /best-drop-taxi-service-sholinganallur.html [R=301,L]
RewriteRule ^best-drop-taxi-service-thoraipakkam$ /best-drop-taxi-service-thoraipakkam.html [R=301,L]
RewriteRule ^best-drop-taxi-service-porur$ /best-drop-taxi-service-porur.html [R=301,L]
RewriteRule ^best-drop-taxi-service-mylapore$ /best-drop-taxi-service-mylapore.html [R=301,L]
RewriteRule ^best-drop-taxi-service-sriperumbudur$ /best-drop-taxi-service-sriperumbudur.html [R=301,L]
RewriteRule ^chennai-airport-taxi$ /chennai-airport-taxi.html [R=301,L]
RewriteRule ^one-way-taxi$ /one-way-taxi.html [R=301,L]
RewriteRule ^outstation-taxi$ /outstation-taxi.html [R=301,L]
RewriteRule ^about$ /about.html [R=301,L]
RewriteRule ^contact$ /contact.html [R=301,L]
RewriteRule ^services$ /services.html [R=301,L]
RewriteRule ^privacy-policy$ /privacy-policy.html [R=301,L]
RewriteRule ^terms$ /terms.html [R=301,L]
RewriteRule ^cancellation-policy$ /cancellation-policy.html [R=301,L]

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/xml
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Prevent caching of all HTML files and root directory pages so updates appear immediately
  Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate" "expr=%{CONTENT_TYPE} =~ m#text/html#"
  Header set Pragma "no-cache" "expr=%{CONTENT_TYPE} =~ m#text/html#"
  Header set Expires "0" "expr=%{CONTENT_TYPE} =~ m#text/html#"

  <FilesMatch "\.(html|htm|php)$">
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options nosniff
  Header set X-Frame-Options DENY
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Custom Error Pages
ErrorDocument 404 /index.html
